{
  "name": "@martinmqz/agent-guidance-sync",
  "version": "0.1.0",
  "description": "Deterministically sync one canonical set of coding-agent guidance to AGENTS.md, CLAUDE.md, Cursor rules, and GitHub Copilot instructions.",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "agent-guidance": "./bin/agent-guidance.mjs"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --test",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents-md",
    "claude-md",
    "copilot-instructions",
    "cursor-rules",
    "developer-tools"
  ],
  "license": "MIT"
}
